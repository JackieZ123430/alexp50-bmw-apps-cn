[Unit]
Description=Read-only BMW remote telemetry publisher
After=network.target mgu-uplink.service
Wants=mgu-uplink.service

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=remote-telemetry-bridge
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /var/opt/remote-telemetry-bridge/current/bridge.js
Restart=always
RestartSec=5
TimeoutStopSec=7

[Install]
WantedBy=multi-user.target
