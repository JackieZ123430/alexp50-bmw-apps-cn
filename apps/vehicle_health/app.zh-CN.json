        ],
        [
          "BTN_SCAN",
          "扫描当前故障"
        ],
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "autoScan",
      "label": "打开时扫描当前故障",
      "type": "bool",
      "default": true
    },
    {
      "key": "tempUnit",
      "label": "温度",
