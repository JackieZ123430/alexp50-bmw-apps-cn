{
  "id": "parking_clearance",
  "title": "泊车与间距",
  "description": "只读显示 PDC 距离、转向轨迹和悬架姿态",
  "version": "0.1.801",
  "vendor": "alexp50",
  "loggingId": "OAAC",
  "iconGlyph": "P",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_instances": "1",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_instances": "1",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.chassis.SteeringAngle": {
      "_optional": "live steering path; PDC distances and suspension stance remain available",
      "ActualSteeringAngleDriver": "s",
      "actualSteeringAngleDriverNoCRC": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "泊车与间距",
      "buttons": [
        [
          "BTN_PAGE",
          "下一页"
        ],
        [
          "BTN_REFRESH",
          "刷新"
        ],
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "vehicleLength",
      "label": "G12 车身长度",
      "type": "number",
      "unit": "cm",
      "default": 526,
      "steps": [
        526
      ]
    },
    {
      "key": "wheelbase",
      "label": "G12 轴距",
      "type": "number",
      "unit": "cm",
      "default": 321,
      "steps": [
        321
      ]
    },
    {
      "key": "warnDistance",
      "label": "黄色提示距离",
      "type": "number",
      "unit": "cm",
      "default": 70,
      "steps": [
        40,
        50,
        60,
        70,
        80,
        100
      ]
    },
    {
      "key": "criticalDistance",
      "label": "红色提示距离",
      "type": "number",
      "unit": "cm",
      "default": 35,
      "steps": [
        20,
        25,
        30,
        35,
        40,
        45
      ]
    },
    {
      "key": "demo",
      "label": "演示数据",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "从不"
        ],
        [
          "on",
          "始终"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "屏幕布局",
      "type": "choice",
      "default": "full",
      "reset": 2,
      "options": [
        [
          "full",
          "全屏"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "渲染器",
      "type": "choice",
      "default": "auto",
      "reset": 2,
      "options": [
        [
          "auto",
          "GPU 60 帧／秒"
        ]
      ]
    }
  ],
  "config": {
    "fullScreenRequired": true
  }
}
