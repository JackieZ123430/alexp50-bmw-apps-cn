        [
          "BTN_PAGE",
          "下一页"
        ],
        [
          "BTN_ACTION",
          "主要操作"
        ],
        [
          "BTN_CLIENT",
          "下一个客户端"
        ],
        [
          "BTN_REFRESH",
          "刷新"
        ]
      ]
    }
  ],
  "settings": [
    {
